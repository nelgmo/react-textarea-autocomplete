{
  "name": "@webscopeio/react-textarea-autocomplete",
  "version": "4.9.2",
  "description": "Offers autocomplete over textarea in style of GitHub.",
  "repository": {
    "type": "git",
    "url": "https://github.com/webscopeio/react-textarea-autocomplete"
  },
  "files": [
    "dist",
    "types.js",
    "style.css"
  ],
  "main": "dist/react-textarea-autocomplete.cjs.js",
  "module": "dist/react-textarea-autocomplete.es.js",
  "unpkg": "dist/react-textarea-autocomplete.umd.min.js",
  "author": "Jakub Benes <jukben@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webscopeio/react-textarea-autocomplete/issues"
  },
  "homepage": "https://github.com/webscopeio/react-textarea-autocomplete",
  "keywords": [
    "react-component",
    "textarea",
    "autocomplete",
    "react"
  ],
  "scripts": {
    "build": "node -e \"require('fs').copyFileSync('src/types.js', 'types.js')\" && rollup -c",
    "dev": "yarn run example --open",
    "example": "webpack serve --config webpack.dev.config.js",
    "example:build": "webpack --config webpack.prod.config.js",
    "prepublishOnly": "yarn run build",
    "lint": "eslint --ext=js --ext=jsx ./src",
    "lint:fix": "yarn run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "flow": "flow",
    "flow:check": "flow check",
    "cypress": "yarn run example & wait-on http://localhost:8080 && cypress run --headed",
    "cypress:open": "cypress open"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-syntax-flow": "^7.25.0",
    "@babel/plugin-transform-flow-strip-types": "^7.25.0",
    "@babel/plugin-transform-react-jsx": "^7.25.0",
    "@babel/plugin-transform-runtime": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/runtime": "^7.25.0",
    "@jukben/emoji-search": "1.1.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "all-contributors-cli": "^6.16.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "cypress": "^13.15.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-prettier": "^5.2.1",
    "flow-bin": "^0.246.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-license": "^3.5.3",
    "style-loader": "^4.0.0",
    "wait-on": "^8.0.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "peerDependencies": {
    "prop-types": "^15.0.0",
    "react": "^16.0.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.0.0 || ^17 || ^18 || ^19"
  },
  "dependencies": {
    "custom-event": "^1.0.1",
    "textarea-caret": "3.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/*.{js,jsx}": [
      "eslint src --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/setupJest.js"
    ],
    "moduleNameMapper": {
      "\\.(css|scss)$": "<rootDir>/__mocks__/styleMock.js"
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      ["@babel/preset-react", { "runtime": "automatic" }]
    ],
    "plugins": [
      "@babel/plugin-transform-flow-strip-types",
      "@babel/plugin-transform-runtime"
    ]
  }
}
